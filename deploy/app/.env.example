# Copy to .env on the server. Keep out of git.

# Public hostname Traefik routes to this app (must match the Cloudflare Tunnel
# public hostname). e.g. saleswind.example.com
APP_HOST=CHANGE_ME

# Internal connection to the Postgres container on the shared Docker network.
# No sslmode needed — traffic stays on the private bridge network.
DATABASE_URL=postgresql://saleswind:YOUR_DB_PASSWORD@saleswind-db:5432/saleswind

# Auth.js secret. Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
