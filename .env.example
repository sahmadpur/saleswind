# Copy to .env on the server (same dir as docker-compose.yml). Keep out of git.

# Public hostname — must match the Cloudflare Tunnel public hostname.
APP_HOST=saleswind.cybercraft.az

# Postgres (used on FIRST init of the data volume).
POSTGRES_USER=saleswind
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=saleswind

# App's connection to the db container (internal network).
# The password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://saleswind:CHANGE_ME@saleswind-db:5432/saleswind

# Auth.js secret. Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
