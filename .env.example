# Copy to .env on the server (same dir as docker-compose.yml). Keep out of git.

# Public hostname — must match the Cloudflare Tunnel public hostname.
APP_HOST=saleswind.cybercraft.az

# Postgres (used on FIRST init of the data volume).
POSTGRES_USER=saleswind
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=saleswind

# App's connection to the db container (internal network).
# The password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://saleswind:CHANGE_ME@saleswind-db:5432/saleswind
# Local dev: point at localhost instead (docker-compose.dev.yml rewrites it for the container):
# DATABASE_URL="postgresql://saleswind:CHANGE_ME@localhost:5432/saleswind?schema=public"

# Auth.js secret. Generate: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# Initial admin account created by the seed (prisma db seed). Optional —
# defaults to admin@saleswind.local / admin1234 if unset. Change in production;
# the password can also be changed in-app from Settings → Change password.
ADMIN_EMAIL=admin@saleswind.local
ADMIN_PASSWORD=CHANGE_ME

# Local dev only — uncomment to layer the dev overlay (ports published, http auth).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# IANA time zone for displayed dates (default Asia/Baku).
APP_TIMEZONE=Asia/Baku

# Web Push notifications (optional). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Microsoft 365: Outlook meetings + "Sign in with Microsoft" (both optional, one app registration).
# Entra ID app registration → Web redirect URIs:
#   https://<APP_HOST>/api/outlook/callback
#   https://<APP_HOST>/api/auth/callback/microsoft-entra-id
# Delegated permissions: openid, profile, email, offline_access, User.Read, Calendars.ReadWrite.
# MS_TENANT_ID must be your directory (tenant) ID for Microsoft sign-in; with it set, anyone in
# that tenant can sign in (first sign-in creates an Agent) and the password form is hidden
# (still reachable at /login?password=1).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
